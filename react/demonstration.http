@baseUrl = http://localhost:8080/api/
### LOBBIES #####

#### GET LOBBIES WITH COOKIE
GET {{baseUrl}}lobbies HTTP/1.1
Cookie: AuthCookie={{token_alice}}


#### GET LOBBIES WITH BEARER TOKEN
GET {{baseUrl}}lobbies HTTP/1.1
Authorization: Bearer {{token_alice}}

### LOGIN ALICE
# @name loginAlice

POST {{baseUrl}}login HTTP/1.1
Content-Type: application/json
Accept: application/json

{
  "username": "Alice",
  "password": "teste"
}
### Guardar Token
@token_alice = {{loginAlice.response.body.data.token}}


### LOGIN BOB
# @name loginBob
POST {{baseUrl}}login HTTP/1.1
Content-Type: application/json
Accept: application/json

{
  "username": "Bob",
  "password": "teste"
}
### Guardar Token
@token_bob = {{loginBob.response.body.data.token}}


### LOGIN CAROL
# @name loginCarol
POST {{baseUrl}}login HTTP/1.1
Content-Type: application/json
Accept: application/json

{
  "username": "Carol",
  "password": "teste"
}
### Guardar Token
@token_carol = {{loginCarol.response.body.data.token}}


### LOGIN DAVE
# @name loginDave
POST {{baseUrl}}login HTTP/1.1
Content-Type: application/json
Accept: application/json

{
  "username": "Dave",
  "password": "teste"
}
### Guardar Token
@token_dave = {{loginDave.response.body.data.token}}

### USERS TESTS #####


###INVITE USER
# @name createInvite
POST {{baseUrl}}users/invitations
Authorization: Bearer {{token_alice}}

### REGISTER USER WITH INVITATION CODE
# @name inviteCode
POST {{baseUrl}}users
Content-Type: application/json
Accept: application/json

{
  "name": "Eve",
  "password": "StrongPassword123!",
  "email": "eve@example.com",
  "invitationCode":"{{createInvite.response.body.data}}"
}


### GET ALL USERS
GET {{baseUrl}}users
Authorization: Bearer {{token_alice}}

### GET USER BY ID
GET {{baseUrl}}users/1
Authorization: Bearer {{token_alice}}


### GET USERS BY NAME (Alice)
GET {{baseUrl}}users?name=Alice
Authorization: Bearer {{token_alice}}

### GET USERS CONTAINING "ob"
GET {{baseUrl}}users?contains=ob
Authorization: Bearer {{token_alice}}

### GET USERS ORDERED BY NAME ASC
GET {{baseUrl}}users?sort=asc
Authorization: Bearer {{token_alice}}

### GET USERS ORDERED BY NAME DESC
GET {{baseUrl}}users?sort=desc
Authorization: Bearer {{token_alice}}

### GET ONLY 2 USERS
GET {{baseUrl}}users?limit=2
Authorization: Bearer {{token_alice}}

### GET USERS SKIPPING FIRST 2
GET {{baseUrl}}users?skip=2
Authorization: Bearer {{token_alice}}

### COMBINATION: Contains + Sort + Limit
GET {{baseUrl}}users?contains=ob&sort=asc&limit=3
Authorization: Bearer {{token_alice}}


### LOGOUT
POST {{baseUrl}}users/logout
Authorization: Bearer {{token_dave}}





### LOBBIES TESTS #####


#### GET LOBBIES
GET {{baseUrl}}lobbies HTTP/1.1
Cookie: AuthCookie={{token_alice}}


### CREATE LOBBY
POST {{baseUrl}}lobby HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token_alice}}

{
  "name": "Lobby Teste",
  "description": "Lobby para testes",
  "maxPlayers": 1,
  "maxRounds": 5,
  "timeoutSeconds": 1
}
### CREATE LOBBY
POST {{baseUrl}}lobby HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token_alice}}

{
  "name": "Lobby Teste",
  "description": "Lobby para testes",
  "maxPlayers": 2,
  "maxRounds": 2,
  "timeoutSeconds": 30
}




#### GET LOBBIES SORTED
GET {{baseUrl}}lobbies?sort=desc HTTP/1.1
Authorization: Bearer {{token_alice}}

#### GET LOBBIES SORTED ASC
GET {{baseUrl}}lobbies?sort=asc HTTP/1.1
Authorization: Bearer {{token_alice}}

#### GET ONLY 2 LOBBIES
GET {{baseUrl}}lobbies?limit=2 HTTP/1.1
Authorization: Bearer {{token_alice}}

#### GET LOBBIES SKIPPING FIRST 2
GET {{baseUrl}}lobbies?limit=2&skip=2 HTTP/1.1
Authorization: Bearer {{token_alice}}

#### GET LOBBIES WHERE NAME CONTAINS
GET {{baseUrl}}lobbies?contains=ta HTTP/1.1
Authorization: Bearer {{token_alice}}

#### GET LOBBY BY ID
GET {{baseUrl}}lobbies/3 HTTP/1.1
Authorization: Bearer {{token_alice}}


### JOIN LOBBY (VAI FALHAR PORQUE JA ESTA NO LOBBY)
POST {{baseUrl}}lobbies/3/join HTTP/1.1
Authorization: Bearer {{token_alice}}

### JOIN LOBBY (VAI DAR CERTO)
POST {{baseUrl}}lobbies/3/join HTTP/1.1
Authorization: Bearer {{token_carol}}

### JOIN LOBBY (VAI FALHAR PORQUE JA COMEÇOU O JOGO)
POST {{baseUrl}}lobbies/3/join HTTP/1.1
Authorization: Bearer {{token_bob}}


### LEAVE LOBBY (VAI FALHAR PORQUE NÂO EXISTE)
POST {{baseUrl}}lobbies/15/leave HTTP/1.1
Authorization: Bearer {{token_alice}}











### MATCH  TESTS #####


### GET MATCH BY ID
GET {{baseUrl}}matches/2
Authorization: Bearer {{token_alice}}

### LIST ROUNDS BY MATCH ID
GET {{baseUrl}}matches/2/rounds
Authorization: Bearer {{token_alice}}

### LIST CURRENT ROUND BY MATCH ID
GET {{baseUrl}}matches/2/rounds/current
Authorization: Bearer {{token_alice}}


### GET CURRENT TURN BY MATCH ID
GET {{baseUrl}}matches/2/turns/current
Authorization: Bearer {{token_alice}}

### GET HAND HISTORY BY MATCH ID
GET {{baseUrl}}matches/2/hands
Authorization: Bearer {{token_alice}}


### Alice Game


### ROLL DICE (First Roll)
POST {{baseUrl}}matches/2/turns/current/roll
Authorization: Bearer {{token_alice}}

### ROLL DICE (Subsequent Rolls)
POST {{baseUrl}}matches/2/turns/current/roll
Content-Type: application/json
Authorization: Bearer {{token_alice}}

{
  "heldMask": "11100"
}

### ROLL DICE (Subsequent Rolls)
POST {{baseUrl}}matches/2/turns/current/roll
Content-Type: application/json
Authorization: Bearer {{token_alice}}

{
  "heldMask": ""
}


### GET HAND HISTORY BY MATCH ID
GET {{baseUrl}}matches/2/hands
Authorization: Bearer {{token_alice}}

### GET MATCH BY ID
GET {{baseUrl}}matches/2
Authorization: Bearer {{token_alice}}


